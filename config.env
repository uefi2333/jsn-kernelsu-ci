# ===== JSN KernelSU CI 配置 =====
# 按你的源码实际情况改，改完 push 或手动跑 Actions

# 内核源（默认：Kirin710 + 已有 KSU 尝试的仓库，适合荣耀8X/JSN）
KERNEL_URL=https://github.com/Coconutat/android_kernel_huawei_kirin710_KSU
KERNEL_BRANCH=EMUI9.1.0

# 若源已含 KernelSU 子模块且你只想重编译，设 true 跳过 setup
SKIP_KSU_SETUP=false

# defconfig：源码 configs 下有 JSN 专用项；优先 JSN，没有再改 merge
# 已确认存在：JSN_kirin710_defconfig / JSN_kirin710_KSU_defconfig / merge_kirin710_defconfig
DEFCONFIG=JSN_kirin710_defconfig

ARCH=arm64
SUBARCH=arm64
KERNEL_DIR=kernel

# kernelsu | kernelsu-next | rksu
KSU_FLAVOR=kernelsu
# 官方非 GKI 最后版本；KSU-Next/RKSU 可改对应 tag 或 main/next
KSU_VERSION=v0.9.5

# kprobe | manual
# 华为 Hisilicon 内核强烈建议 manual
KSU_HOOK=manual

# gcc-4.9 | aosp-clang
TOOLCHAIN=gcc-4.9
CLANG_VERSION=r383902
ANDROID_VERSION=9

# 老 gcc-4.9 默认关 ccache（路径/32位兼容坑多）
USE_CCACHE=0

LOCALVERSION=-JSN-KSU
# enforcing | permissive
SELINUX_MODE=enforcing

# 并行
JOBS=8

# 可选：stock boot.img 直链，提供后 CI 尝试 magiskboot 换核
STOCK_BOOT_URL=

# Release 前缀
RELEASE_PREFIX=JSN-EMUI9.1
