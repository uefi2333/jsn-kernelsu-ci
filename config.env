# ===== JSN SukiSU Ultra CI (EMUI 9.1) =====
# Honor 8X / JSN / Kirin 710 / non-GKI

KERNEL_URL=https://github.com/Coconutat/android_kernel_huawei_kirin710_KSU
KERNEL_BRANCH=EMUI9.1.0

# 源里自带 tiann/KernelSU 子模块，CI 会清掉再装 SukiSU
SKIP_KSU_SETUP=false

# 已确认源码存在
DEFCONFIG=JSN_kirin710_defconfig

ARCH=arm64
SUBARCH=arm64
KERNEL_DIR=kernel

# kernelsu | kernelsu-next | rksu | sukisu
KSU_FLAVOR=sukisu
# SukiSU v4+ 架构/依赖大变且强绑 KPROBES；4.9 非GKI 用 v3.2.0（含 MANUAL_HOOK）
KSU_VERSION=v3.2.0

# kprobe | manual  （华为 Hisilicon 强烈建议 manual）
KSU_HOOK=manual

# gcc-4.9 | aosp-clang
TOOLCHAIN=gcc-4.9
CLANG_VERSION=r383902
ANDROID_VERSION=9

# 老 gcc-4.9 默认关 ccache
USE_CCACHE=0

LOCALVERSION=-JSN-SukiSU
# enforcing | permissive
SELINUX_MODE=enforcing

JOBS=8

# 可选：stock boot.img 直链
STOCK_BOOT_URL=

# Release 前缀
RELEASE_PREFIX=JSN-EMUI9.1-SukiSU
